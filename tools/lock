#!/usr/bin/env bash
# Cheap kernel-level prevention (enforcement ladder, process/automation.md):
# make all human-only prose read-only. Run after your writing session.
set -euo pipefail
cd "$(dirname "$0")/.."
find works/*/drafts world/artifacts/texts blog/drafts -type f -name '*.md' \
  -exec chmod a-w {} + 2>/dev/null || true
echo "prose locked (read-only). tools/unlock before your next writing session."
